
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Tahoma, Arial, sans-serif;
    background: #101827;
    color: white;
}

header {
    background: #172438;
    padding: 25px 20px;
}

h1 {
    font-size: 23px;
}

.container {
    max-width: 600px;
    margin: auto;
    padding: 20px;
}

.balance {
    background: linear-gradient(135deg, #1769aa, #6338b8);
    padding: 25px;
    border-radius: 18px;
}

.balance h2 {
    font-size: 30px;
}

.actions {
    display: flex;
    gap: 12px;
    margin: 20px 0;
}

button {
    flex: 1;
    padding: 14px;
    border: none;
    border-radius: 12px;
    background: #2389e9;
    color: white;
    font-size: 15px;
}

.coin {
    background: #1c2b40;
    padding: 17px;
    border-radius: 13px;
    margin-bottom: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.symbol {
    background: #344b68;
    border-radius: 50%;
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
}

footer {
    text-align: center;
    color: #8fa0b5;
    padding: 25px;
}
